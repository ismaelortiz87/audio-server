<?xml version="1.0" encoding="utf-8"?>
<!-- A4: adaptive launcher icon. Same resource name as the Projucer's legacy
     drawable-*/icon.png, so android:icon="@drawable/icon" gets this on API 26+
     and the PNG below. Foreground = the P3.10 maskable artwork (inside the
     safe zone), background = #12161a. Do not decode this with BitmapFactory. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
