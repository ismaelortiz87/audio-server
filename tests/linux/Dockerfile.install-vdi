# install-vdi.sh test image: debian:trixie with systemd as PID 1, sudo for the
# desktop user, PipeWire, and a local aooserver. Unlike Dockerfile.systemd the
# .deb is NOT preinstalled: installing it is the script's job.
FROM debian:trixie AS aoo
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config ca-certificates \
        libasound2-dev libfreetype6-dev libfontconfig1-dev libx11-dev libxcomposite-dev \
        libxcursor-dev libxext-dev libxinerama-dev libxrandr-dev libxrender-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY aooserver/ /src/aooserver/
RUN cmake -S /src/aooserver -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /build -j"$(nproc)" && test -x /build/aooserver

FROM debian:trixie
ENV DEBIAN_FRONTEND=noninteractive container=docker
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus dbus-user-session libpam-systemd sudo \
        pipewire pipewire-pulse wireplumber pipewire-alsa pulseaudio-utils \
        python3-minimal curl procps iproute2 util-linux ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=aoo /build/aooserver /usr/local/bin/aooserver
RUN useradd -m -u 1000 -s /bin/bash vdi \
 && echo 'vdi ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/vdi \
 && printf '[Unit]\nDescription=local aooserver\n[Service]\nExecStart=/usr/local/bin/aooserver -p 10998\nRestart=always\n[Install]\nWantedBy=multi-user.target\n' \
      > /etc/systemd/system/aooserver.service \
 && systemctl enable aooserver.service \
 && systemctl mask getty.target console-getty.service ; true
COPY crosspoint_*.deb install-vdi.sh /home/vdi/dist/
RUN chown -R vdi:vdi /home/vdi/dist && chmod +x /home/vdi/dist/install-vdi.sh
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
