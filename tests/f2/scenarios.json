{
  "_doc": [
    "Scenario definitions for the tests/f2 multi-peer harness.",
    "",
    "Each scenario has:",
    "  description : human readable summary",
    "  group       : AOO group name all peers join",
    "  routing     : the TARGET routing model ('mesh' or 'matrix')",
    "  expect      : what the harness compares against TODAY (default: routing).",
    "                Use 'all-blocked' while a target model is not implemented,",
    "                and explain it in 'pending'.",
    "  pending     : optional note explaining why expect differs from routing",
    "  env         : optional env vars for every peer in the scenario",
    "  peers       : list of { name, role, advertise?, env? }",
    "",
    "Peer role semantics (verified against the real built app):",
    "  role: null      -> no --role flag; the real app defaults to 'console'.",
    "  role: 'console' -> pass --role console (selfRole 'console').",
    "  role: 'vdi'     -> pass --role vdi (selfRole 'vdi').",
    "  advertise:false -> set SONOBUS_NO_ROLE_ADVERT=1: the peer's own selfRole",
    "                     stays its default, but other peers observe 'unknown'",
    "                     with hasRole=false. This is the stock-SonoBus case.",
    "",
    "Verified ground truth (real binaries, see README 'Verified behaviour'):",
    "  3 role-less peers + SONOBUS_NO_ROLE_BLOCK=1 -> full mesh, all flags true.",
    "  role-less peer + SONOBUS_NO_ROLE_ADVERT=1   -> observed role 'unknown',",
    "                                                 both directions blocked.",
    "  console + vdi (no env)                      -> both directions OPEN (P1.4",
    "                                                 applies the routing matrix",
    "                                                 on role arrival).",
    "  console + console, or vdi + vdi (no env)    -> both directions blocked",
    "                                                 (same role).",
    "",
    "P1.5 steps (real app only): 'steps' is a list of { name, control, expect,",
    "  timeout?, hold? }. After the routing model settles, each step writes",
    "  control[peer] (deep-merged with earlier steps) to that peer's",
    "  --test-control file, then waits until every 'expect' assertion holds for",
    "  'hold' seconds. See evaluate.py run_steps for the assertion checks.",
    "  SONOBUS_TEST_TONE_HZ=<hz> replaces a peer's input with a -12 dBFS sine.",
    "  Silence is asserted as a peak <= -60 dBFS (the dump reports -100 for none)."
  ],
  "scenarios": {
    "mesh-stock": {
      "description": "Pre-roles stock behaviour: three peers with no advertised role and open routing. Passes against the real app today.",
      "group": "f2-mesh-stock",
      "routing": "mesh",
      "expect": "mesh",
      "env": {
        "SONOBUS_NO_ROLE_BLOCK": "1"
      },
      "peers": [
        { "name": "p1", "role": null },
        { "name": "p2", "role": null },
        { "name": "p3", "role": null }
      ]
    },
    "matrix-1v1": {
      "description": "One console and one vdi. Opposite roles, so the routing matrix opens the path both ways.",
      "group": "f2-matrix-1v1",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        { "name": "c1", "role": "console" },
        { "name": "v1", "role": "vdi" }
      ]
    },
    "matrix-2v2": {
      "description": "Two consoles and two vdis. Targets the routing matrix: console<->vdi allowed both ways, same-role pairs blocked.",
      "group": "f2-matrix-2v2",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        { "name": "c1", "role": "console" },
        { "name": "c2", "role": "console" },
        { "name": "v1", "role": "vdi" },
        { "name": "v2", "role": "vdi" }
      ]
    },
    "blocked-unknown": {
      "description": "Two peers that advertise no role at all (stock SonoBus behaviour). The matrix blocks every direction when either side is unknown, so this passes against the real app today.",
      "group": "f2-blocked-unknown",
      "routing": "matrix",
      "expect": "all-blocked",
      "peers": [
        { "name": "u1", "role": null, "advertise": false },
        { "name": "u2", "role": null, "advertise": false }
      ]
    },
    "matrix-target-check": {
      "description": "Same peers as matrix-1v1 but compared against the TARGET matrix model. Since P1.4 this passes; kept as the explicit acceptance test for the routing matrix.",
      "group": "f2-matrix-1v1",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        { "name": "c1", "role": "console" },
        { "name": "v1", "role": "vdi" }
      ]
    },
    "agent-health": {
      "description": "One console + one VDI whose agent reports a missing input device. P1.7: the VDI attaches an 'agent' object to its peer-info JSON, and the Console must parse it, so c1's dump for v1 shows input 'missing'. The VDI's own dump reports the same health under selfAgent.",
      "group": "f2-agent-health",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        {
          "name": "c1",
          "role": "console"
        },
        {
          "name": "v1",
          "role": "vdi",
          "env": {
            "SONOBUS_AGENT_INPUT": "missing"
          },
          "agent": {
            "input": "missing",
            "output": "ok",
            "paused": false,
            "config_error": null
          }
        }
      ]
    },
    "agent-silent": {
      "description": "P1.7 silence detection on the REAL path: a VDI with no input override and a 2 s silence window (default is 10 min). Headless peers feed silence, so the real detector must flip input to 'silent'.",
      "group": "f2-agent-silent",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        {
          "name": "c1",
          "role": "console"
        },
        {
          "name": "v1",
          "role": "vdi",
          "env": {
            "SONOBUS_AGENT_SILENT_SECS": "2"
          },
          "agent": {
            "input": "silent",
            "output": "ok"
          }
        }
      ]
    },
    "console-kind": {
      "description": "P1.7 / control-api 7: Consoles advertise their kind next to role. c1 is a web Console, c2 a mac Console (both via CROSSPOINT_CONSOLE_KIND); every peer sees the right kind.",
      "group": "f2-console-kind",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        {
          "name": "c1",
          "role": "console",
          "kind": "web",
          "env": {
            "CROSSPOINT_CONSOLE_KIND": "web"
          }
        },
        {
          "name": "c2",
          "role": "console",
          "kind": "mac",
          "env": {
            "CROSSPOINT_CONSOLE_KIND": "mac"
          }
        },
        {
          "name": "v1",
          "role": "vdi"
        }
      ]
    },
    "config-yaml": {
      "description": "P2.1: one console and one vdi started ONLY from YAML files (server, group, username and role all come from --config; no -c/-g/-n/--role on the command line).",
      "group": "f2-config-yaml",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        { "name": "c1", "role": "console", "cli_flags": false, "cli_role": null,
          "config": { "server": "%HOST%:%PORT%", "group": "%GROUP%", "username": "%NAME%", "role": "console" } },
        { "name": "v1", "role": "vdi", "cli_flags": false, "cli_role": null,
          "config": { "server": "%HOST%:%PORT%", "group": "%GROUP%", "username": "%NAME%", "role": "vdi" } }
      ]
    },
    "config-precedence": {
      "description": "P2.1: --role vdi on the command line beats a YAML that says console AND a --load-setup file saved as console (CLI > YAML > setup file > saved state). Expect selfRole vdi; c1 is a plain console peer.",
      "group": "f2-config-precedence",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        { "name": "c1", "role": "console" },
        { "name": "v1", "role": "vdi", "cli_role": "vdi", "setup_role": "console",
          "config": { "role": "console" } }
      ]
    },
    "talk-gate": {
      "description": "P1.5: 1 console (660 Hz tone as its mic) + 2 VDIs. Talk off for v2: v2 hearsYou=false and receives silence from the console, v1 still receives the tone, and the c1->v2 stream stays up (gain gate, not a stream stop). Talk back on restores v2.",
      "group": "f2-talk-gate",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        {"name": "c1", "role": "console", "env": {"SONOBUS_TEST_TONE_HZ": "660"}},
        {"name": "v1", "role": "vdi"},
        {"name": "v2", "role": "vdi"}
      ],
      "steps": [
        {
          "name": "all-talk",
          "expect": [
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": true},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": true},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "min": -16},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "min": -16}
          ]
        },
        {
          "name": "talk-off-v2",
          "control": {"c1": {"talk": {"v2": false}}},
          "hold": 3,
          "expect": [
            {"peer": "c1", "of": "v2", "field": "talk", "eq": false},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": false},
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": true},
            {"peer": "c1", "of": "v2", "field": "sendGateGain", "eq": 0},
            {"peer": "c1", "of": "v1", "field": "sendGateGain", "eq": 1},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "max": -60},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "min": -16},
            {"peer": "c1", "of": "v2", "field": "sendActive", "eq": true},
            {"peer": "v2", "of": "c1", "field": "receivingAudio", "eq": true},
            {"peer": "c1", "of": "v2", "field": "packetsSent", "increases": true},
            {"peer": "v2", "of": "c1", "field": "packetsReceived", "increases": true}
          ]
        },
        {
          "name": "talk-on-v2",
          "control": {"c1": {"talk": {"v2": true}}},
          "expect": [
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": true},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "min": -16}
          ]
        }
      ]
    },
    "solo-narrow": {
      "description": "P1.5: solo narrows talk. All talk on, v1 soloed -> only v1 hearsYou (and only v1 receives the console tone); un-solo -> both. Then talk off for v2 and solo v2: solo wins over the talk flag; un-solo restores the kept talk flags (v2 off, v1 on).",
      "group": "f2-solo-narrow",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        {"name": "c1", "role": "console", "env": {"SONOBUS_TEST_TONE_HZ": "660"}},
        {"name": "v1", "role": "vdi"},
        {"name": "v2", "role": "vdi"}
      ],
      "steps": [
        {
          "name": "all-talk",
          "expect": [
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": true},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": true}
          ]
        },
        {
          "name": "solo-v1",
          "control": {"c1": {"solo": ["v1"]}},
          "expect": [
            {"peer": "c1", "of": "v1", "field": "solo", "eq": true},
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": true},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": false},
            {"peer": "c1", "of": "v2", "field": "talk", "eq": true},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "min": -16},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "max": -60}
          ]
        },
        {
          "name": "unsolo",
          "control": {"c1": {"solo": []}},
          "expect": [
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": true},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": true},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "min": -16},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "min": -16}
          ]
        },
        {
          "name": "solo-beats-talk",
          "control": {"c1": {"talk": {"v2": false}, "solo": ["v2"]}},
          "expect": [
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": true},
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": false},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "min": -16},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "max": -60}
          ]
        },
        {
          "name": "talk-restored",
          "control": {"c1": {"solo": []}},
          "expect": [
            {"peer": "c1", "of": "v2", "field": "talk", "eq": false},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": false},
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": true},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "max": -60},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "min": -16}
          ]
        }
      ]
    },
    "solo-dim": {
      "description": "P1.5: solo dims, doesn't cut. VDIs send tones (v1 440 Hz, v2 880 Hz). With v1 soloed on the console, v2's post-gain level is its pre-fader level -18 dB (+/-2) and its pre-fader level is unchanged; v1 is not dimmed. Un-solo restores v2.",
      "group": "f2-solo-dim",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        {"name": "c1", "role": "console"},
        {"name": "v1", "role": "vdi", "env": {"SONOBUS_TEST_TONE_HZ": "440"}},
        {"name": "v2", "role": "vdi", "env": {"SONOBUS_TEST_TONE_HZ": "880"}}
      ],
      "steps": [
        {
          "name": "baseline",
          "hold": 3,
          "expect": [
            {"peer": "c1", "of": "v2", "field": "preFaderPeakDb", "min": -16, "capture": "v2pre"},
            {"peer": "c1", "of": "v2", "field": "postGainPeakDb", "near": {"field": "preFaderPeakDb", "offset": 0, "tol": 1}},
            {"peer": "c1", "of": "v1", "field": "postGainPeakDb", "near": {"field": "preFaderPeakDb", "offset": 0, "tol": 1}}
          ]
        },
        {
          "name": "solo-v1",
          "control": {"c1": {"solo": ["v1"]}},
          "hold": 3,
          "expect": [
            {"peer": "c1", "of": "v1", "field": "solo", "eq": true},
            {"peer": "c1", "field": "soloDimDb", "eq": -18},
            {"peer": "c1", "of": "v2", "field": "postGainPeakDb", "near": {"field": "preFaderPeakDb", "offset": -18, "tol": 2}},
            {"peer": "c1", "of": "v2", "field": "preFaderPeakDb", "near": {"capture": "v2pre", "offset": 0, "tol": 2}},
            {"peer": "c1", "of": "v1", "field": "postGainPeakDb", "near": {"field": "preFaderPeakDb", "offset": 0, "tol": 1}},
            {"peer": "c1", "of": "v2", "field": "receivingAudio", "eq": true}
          ]
        },
        {
          "name": "unsolo",
          "control": {"c1": {"solo": []}},
          "expect": [
            {"peer": "c1", "of": "v2", "field": "postGainPeakDb", "near": {"field": "preFaderPeakDb", "offset": 0, "tol": 1}}
          ]
        }
      ]
    },
    "mute-prefader": {
      "description": "P1.5: mute is playback gain 0 with the receive stream kept. VDIs send tones; with v2 muted on the console, v2's post-gain level is silence while its pre-fader level still shows the tone and the stream keeps receiving; v1 is unaffected. Unmute restores v2.",
      "group": "f2-mute-prefader",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        {"name": "c1", "role": "console"},
        {"name": "v1", "role": "vdi", "env": {"SONOBUS_TEST_TONE_HZ": "440"}},
        {"name": "v2", "role": "vdi", "env": {"SONOBUS_TEST_TONE_HZ": "880"}}
      ],
      "steps": [
        {
          "name": "baseline",
          "expect": [
            {"peer": "c1", "of": "v2", "field": "postGainPeakDb", "min": -16},
            {"peer": "c1", "of": "v2", "field": "preFaderPeakDb", "min": -16}
          ]
        },
        {
          "name": "mute-v2",
          "control": {"c1": {"mute": ["v2"]}},
          "hold": 3,
          "expect": [
            {"peer": "c1", "of": "v2", "field": "mute", "eq": true},
            {"peer": "c1", "of": "v2", "field": "postGainPeakDb", "max": -60},
            {"peer": "c1", "of": "v2", "field": "preFaderPeakDb", "min": -16},
            {"peer": "c1", "of": "v2", "field": "receivingAudio", "eq": true},
            {"peer": "c1", "of": "v2", "field": "packetsReceived", "increases": true},
            {"peer": "c1", "of": "v1", "field": "postGainPeakDb", "min": -16}
          ]
        },
        {
          "name": "unmute",
          "control": {"c1": {"mute": []}},
          "expect": [
            {"peer": "c1", "of": "v2", "field": "postGainPeakDb", "near": {"field": "preFaderPeakDb", "offset": 0, "tol": 1}}
          ]
        }
      ]
    },
    "ptt": {
      "description": "P1.5: push-to-talk. Mic mode ptt, not held -> micTransmitting false and nobody hearsYou (VDIs receive silence); held -> both hear the console tone; released -> nobody again.",
      "group": "f2-ptt",
      "routing": "matrix",
      "expect": "matrix",
      "peers": [
        {"name": "c1", "role": "console", "env": {"SONOBUS_TEST_TONE_HZ": "660"}},
        {"name": "v1", "role": "vdi"},
        {"name": "v2", "role": "vdi"}
      ],
      "steps": [
        {
          "name": "ptt-up",
          "control": {"c1": {"mic": {"mode": "ptt", "on": true, "ptt": false}}},
          "hold": 3,
          "expect": [
            {"peer": "c1", "field": "micMode", "eq": "ptt"},
            {"peer": "c1", "field": "micTransmitting", "eq": false},
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": false},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": false},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "max": -60},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "max": -60},
            {"peer": "v1", "of": "c1", "field": "receivingAudio", "eq": true}
          ]
        },
        {
          "name": "ptt-held",
          "control": {"c1": {"mic": {"ptt": true}}},
          "expect": [
            {"peer": "c1", "field": "micTransmitting", "eq": true},
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": true},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": true},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "min": -16},
            {"peer": "v2", "of": "c1", "field": "preFaderPeakDb", "min": -16}
          ]
        },
        {
          "name": "ptt-released",
          "control": {"c1": {"mic": {"ptt": false}}},
          "expect": [
            {"peer": "c1", "of": "v1", "field": "hearsYou", "eq": false},
            {"peer": "c1", "of": "v2", "field": "hearsYou", "eq": false},
            {"peer": "v1", "of": "c1", "field": "preFaderPeakDb", "max": -60}
          ]
        }
      ]
    }
  }
}
