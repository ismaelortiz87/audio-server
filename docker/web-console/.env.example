# One web Console instance (P7.5). Copy per user, edit, then:
#   docker compose -p xp-<user> --env-file <this file> -f docker/web-console/docker-compose.yml up -d --build

# Long random secret; the browser signs in with it once (spec §3.10).
CROSSPOINT_API_TOKEN=replace-with-output-of-openssl-rand-hex-24
# The public URL the browser uses (through the reverse proxy).
CROSSPOINT_API_ORIGIN=https://crosspoint.app.lagreca.io
# This host's VPN IP: WebRTC media goes here directly, not through the proxy.
RTC_PUBLIC_IP=10.8.0.2
# UDP range for WebRTC. Unique per instance on the host.
RTC_UDP_MIN=40000
RTC_UDP_MAX=40019
# Host ports the proxy talks to. Unique per instance.
HTTP_PORT=7070
RTC_HTTP_PORT=8090
# Interface those HTTP ports bind to (the proxy-facing one).
HTTP_BIND=127.0.0.1
# This user's Console config (role console, server, group, username).
CONSOLE_CONFIG=./console.example.yaml
