# P2.10: builds the Linux standalone in debian:trixie and packages it as a .deb.
# Context MUST be the monorepo root; scripts/build-deb.sh drives this.
# Build deps mirror tests/linux/Dockerfile (keep them in step).
FROM debian:trixie AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config ca-certificates \
        libasound2-dev libjack-jackd2-dev libfreetype6-dev libfontconfig1-dev \
        libx11-dev libxcomposite-dev libxcursor-dev libxext-dev libxinerama-dev \
        libxrandr-dev libxrender-dev libopus-dev libcurl4-openssl-dev \
        dpkg-dev binutils lintian xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY juce/    /src/juce/
COPY aoo/     /src/aoo/
COPY design/icon/ /src/design/icon/
COPY sonobus/ /src/sonobus/
# The agent's localhost web UI (P2.6). The engine serves it from --ui-dir, so the
# package installs it to /usr/share/crosspoint/ui and the systemd unit passes it.
COPY console-ui/ /src/console-ui/
RUN cmake -S /src/sonobus -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /build --target SonoBus_Standalone -j"$(nproc)" \
 && ls /build/SonoBus_artefacts/Release/Standalone/

COPY packaging/debian/ /src/packaging/debian/
ARG DEB_VERSION
ARG SDE=1700000000
ENV SRC=/src VERSION=${DEB_VERSION} SOURCE_DATE_EPOCH=${SDE}
RUN BIN="$(find /build/SonoBus_artefacts/Release/Standalone -maxdepth 1 -type f -perm -u+x | head -1)" \
    bash /src/packaging/debian/make-deb.sh
RUN cd /out && (lintian --tag-display-limit 0 -I crosspoint_*.deb > /out/lintian.txt 2>&1 || true)
